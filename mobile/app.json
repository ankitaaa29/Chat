{
  "expo": {
    "name": "PulseChat Mobile",
    "slug": "chat-mobile",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090D16"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ankitaaaa.chatmobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090D16"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-file-system",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share images with friends.",
          "cameraPermission": "The app accesses your camera to let you capture and send photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "af4fc7ce-e1c4-4c75-9622-805567a88c96"
      }
    }
  }
}
